DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
PARSE_API_KEY=

# Ana sayfadaki admin girişi. Gerçek değerleri GitHub'a koyma.
# Render > Environment bölümünde tanımla.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Opsiyonel ama önerilir: uzun rastgele bir oturum imzalama anahtarı.
# Boş bırakılırsa ADMIN_PASSWORD kullanılır.
ADMIN_SESSION_SECRET=

# Eski gizli admin sayfası geriye dönük uyumluluk için tutuluyor.
# Yeni panel bunu kullanmıyor.
ADMIN_PRICE_KEY=

# Opsiyonel: aynı ürünü farklı isimlerle bulurken ikinci doğrulama katmanı.
OPENAI_API_KEY=
OPENAI_MATCH_MODEL=gpt-5-mini
