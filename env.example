DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
PARSE_API_KEY=

# Manuel fiyat endpointi için uzun ve rastgele bir gizli anahtar kullan.
# Bunu GitHub'a gerçek değer olarak koyma; Render Environment'ta ayarla.
ADMIN_PRICE_KEY=

# Opsiyonel: aynı ürünü farklı isimlerle bulurken ikinci doğrulama katmanı.
# Yoksa sistem yalnız katı deterministik eşleştirmeyi kullanır.
OPENAI_API_KEY=
OPENAI_MATCH_MODEL=gpt-5-mini
